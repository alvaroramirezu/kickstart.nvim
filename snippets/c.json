{
  "C Header Template": {
    "prefix": "chead",
    "body": [
      "/******************************************************************************",
      " * @file    ${TM_FILENAME}",
      " * @brief   ${1:Brief description of this file.}",
      " ******************************************************************************/",
      "",
      "#ifndef ${TM_FILENAME_BASE/(.*)/${1:/upcase}_H/}",
      "#define ${TM_FILENAME_BASE/(.*)/${1:/upcase}_H/}",
      "",
      "#ifdef __cplusplus",
      "extern \"C\" {",
      "#endif",
      "",
      "/******************************************************************************",
      " * Includes",
      " ******************************************************************************/",
      "",
      "",
      "/******************************************************************************",
      " * Public Macros",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Public Types",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Public Functions Prototypes",
      " ******************************************************************************/",
      "",
      "#ifdef __cplusplus",
      "}",
      "#endif",
      "",
      "#endif /* ${TM_FILENAME_BASE/(.*)/${1:/upcase}_H_/} */"
    ],
    "description": "C header file template with section headers and auto guards"
  },

  "C Source Template": {
    "prefix": "csrc",
    "body": [
      "/******************************************************************************",
      " * @file    ${TM_FILENAME}",
      " * @brief   ${1:Brief description of this file.}",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Includes",
      " ******************************************************************************/",
      "",
      "#include \"${TM_FILENAME_BASE}.h\" /*!< Always include file header */",
      "",
      "/******************************************************************************",
      " * Private Macros",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Private Types",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Private Global Variables",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Private Function Prototypes",
      " ******************************************************************************/",
      "",
      "/******************************************************************************",
      " * Private Functions",
      " ******************************************************************************/",
      "",
      "",
      "/******************************************************************************",
      " * Public Functions",
      " ******************************************************************************/",
      "",
      "/****End of File****/"
    ],
    "description": "Source file template with section headers"
  },

  "Title section comment": {
    "prefix": "add_section",
    "body": [
      "/******************************************************************************",
      " * ${1:Section Title}",
      " ******************************************************************************/"
    ],
    "description": "80-character section header"
  },

  "Enum value with inline doxygen": {
    "prefix": "edoc",
    "body": [
      "${1:NAME}_{2},\t\t\t/*!< ${3:description} */"
    ],
    "description": "Enum value with /*!< ... */ inline Doxygen"
  },
  "struct value with inline doxygen": {
    "prefix": "tdoc",
    "body": [
      "${1:type name}_{2};\t\t\t/*!< ${3:description} */"
    ],
    "description": "Struct value with /*!< ... */ inline Doxygen"
  },

  "Lowercase filename base": {
    "prefix": "fname",
    "body": [
      "${TM_FILENAME_BASE/^(.+)$/${1:/downcase}/}_${2:type your definition}"
    ],
    "description": "insert lowercase filename base"
  },

   "Uppercase filename base": {
    "prefix": "FNAME",
    "body": [
      "${TM_FILENAME_BASE/^(.+)$/${1:/upcase}/}_${2:TYPE YOUR DEFINITION}"
    ],
    "description": "insert uppercase filename base"
  },

  "Enum template from filename": {
    "prefix": "tenum",
    "description": "Create typedef enum using filename",
    "body": [
      "typedef enum",
      "{",
      "\t${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_${2:MYITEM1},\t\t\t/*!< ${3:description} */",
      "\t${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_${4:MYITEM2},\t\t\t/*!< ${5:description} */",
      "} ${TM_FILENAME_BASE/(.*)/${1:/downcase}/}_${6:ENUM_NAME}_t;"
    ]
  },

  "Struct template from filename": {
    "prefix": "tstruct",
    "description": "Create typedef struct using filename",
    "body": [
      "typedef struct",
      "{",
      "\t${1:type name}; /*!< ${2:description} */",
      "} ${TM_FILENAME_BASE/(.*)/${1:/downcase}/}_${3:name}_t;"
    ]
  },

  "Add inline doxygen comment": {
    "prefix": "citem",
    "body": [
      "/*!< ${1:description} */"
    ],
    "description": "inline doxygen comment"
  }


}

